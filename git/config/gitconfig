	name = Justin Locsei
	email = justin.locsei@gmail.com
[push]
	default = tracking
[branch]
	autosetuprebase = always
[core]
	editor = /usr/bin/vim
	precomposeunicode = false
	pager =
[color]
	ui = true
[merge]
	log = 50
	summary = true
	tool = vscode
[mergetool "vscode"]
  cmd = code --wait $MERGED
[diff]
  tool = vscode
[difftool "vscode"]
  cmd = code --wait --diff \"$LOCAL\" \"$REMOTE\"
