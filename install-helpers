# shellcheck shell=bash

# Resolve a path relative to the repository root
#
# @param $1 A root-relative path
# @return The resolved absolute path
child_path() {
  printf "%s/%s" "${DOTFILES_ROOT:?no root directory set}" "$1"
}

# Print a character-based divider that spans the screen
#
# @param $1 The character to use
show_divider() {
  printf "%*s" "$(tput cols)" "" | tr " " "$1"
  echo
}

# Print the title of a module, wrapped by dividers
#
# @param $1 The module name
show_module_title() {
  show_divider "="
  echo "Module: $1"
  show_divider "="

  echo
}

# Log a message related to an action
#
# @param $1 The color to use
# @param $2 The action state
# @param $3 The message
log_action() {
  local esc_seq="\x1b["

  echo -e "$esc_seq${1}[$2] $3 ${esc_seq}39;49;00m"
}

# Show a failed action
#
# @param $1 A message
fail_action() {
  log_action "31;01m" "FAIL" "$1"
}

# Execute an action
#
# @param $1 A message
perform_action() {
  log_action "32;01m" "EXEC" "$1"
}

# SKip an action
#
# @param $1 A message
skip_action() {
  log_action "33;01m" "SKIP" "$1"
}

# Ensure that a symlink exists to a file
#
# @param $1 The description of the symlink
# @param $2 The source file
# @param $3 The target file
ensure_symlink_exists() {
  local description=$1
  local source=$2
  local target=$3

  if [[ -L "$target" ]]; then
    skip_action "${description}: link exists"
  elif [[ -f "$target" ]]; then
    fail_action "${description}: file exists"
  else
    perform_action "${description}: creating symlink"
    ln -s "$source" "$target"
  fi
}

# Ensure that a directory exists
#
# @param $1 The description of the directory
# @param $2 The path of the directory
ensure_directory_exists() {
  local description=$1
  local path=$2

  if [[ -d "$path" ]]; then
    skip_action "${description}: directory exists"
  else
    perform_action "${description}: creating directory"
    mkdir "$path"
  fi
}
